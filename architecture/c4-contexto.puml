@startuml EduLine-C4-Contexto
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()
title EduLine - Diagrama de contexto (C4 nivel 1)

Person(est, "Estudiante", "Toma cursos, entrega tareas y rinde evaluaciones")
Person(doc, "Docente", "Publica contenido, califica y da tutorías")
Person(adm, "Administrador", "Configura la institución, los usuarios y el producto")

System(edu, "EduLine", "Plataforma de aprendizaje derivable por configuración: EduSchool, EduAcademy, EduCampus y EduCorp")

System_Ext(idp, "IdP corporativo", "Identidad institucional (SAML/OIDC)")
System_Ext(pay, "Pasarela de pagos", "Cobro con tarjeta")
System_Ext(erp, "ERP / RR. HH.", "Personal y resultados")
System_Ext(lti, "Herramientas LTI", "Laboratorios y editores externos")
System_Ext(vid, "Servicio de video", "Clases en vivo")

Rel(est, edu, "Usa", "HTTPS, app móvil")
Rel(doc, edu, "Usa", "HTTPS, app móvil")
Rel(adm, edu, "Configura", "HTTPS")
Rel(edu, idp, "Autentica (VP1)", "OIDC/SAML")
Rel(edu, pay, "Cobra cursos (VP6)", "API")
Rel(edu, erp, "Sincroniza (VP9)", "API")
Rel(edu, lti, "Lanza herramientas (VP9)", "LTI 1.3")
Rel(edu, vid, "Transmite clases (VP4)", "API")

SHOW_LEGEND()
@enduml
